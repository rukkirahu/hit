{
    "name": "heindrich/hit",
    "description": "HIT Base Library",
    "authors": [
        {
            "name": "Indrek Pärnamaa",
            "email": "indrek@holdit.ee"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-ldap": "*",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "symfony/ldap": "^7.2",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.7",
        "nyholm/psr7": "^1.8",
        "carthage-software/mago": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Hit\\": "src/"
        },
        "files": [
            "src/Db/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "pestphp/pest-plugin": true
        }
    }
}